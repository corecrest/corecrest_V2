# Notification gateway credentials.
#
# Server-side only: these are read by server/send-notification.ts, which runs in
# a Netlify Function (production) or the Vite dev middleware (local). They are
# deliberately NOT prefixed with VITE_ — anything with that prefix is inlined
# into the client bundle and would be public.
#
# Copy to .env and fill in. In production, set the same names in
# Netlify → Site configuration → Environment variables.

CCNG_CORECREST_STAGING_KEY=
CCNG_EMAIL_SENDER_PROFILE_ID=

# Optional: override the gateway endpoint (defaults to staging).
# CCNG_API_URL=https://staging-cng.corecrest.tech/api/v1/notifications
